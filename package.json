{
  "name": "tongzhang",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12.6.0 <13"
  },
  "scripts": {
    "env:setup": "node scripts/setup-env.mjs",
    "dev:ios": "node scripts/dev.mjs --ios",
    "build:shared": "pnpm -r --filter \"./packages/*\" build",
    "dev:shared": "pnpm --parallel --filter \"./packages/*\" dev",
    "dev:server": "pnpm build:shared && pnpm --filter @tongzhang/server build && concurrently -k -n shared,server \"pnpm dev:shared\" \"pnpm --filter @tongzhang/server dev\"",
    "dev:mobile": "pnpm build:shared && pnpm --filter @tongzhang/mobile dev",
    "build:server": "pnpm build:shared && pnpm --filter @tongzhang/server build",
    "check": "pnpm build:shared && pnpm typecheck && pnpm lint && pnpm format:check",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build:shared && vitest run",
    "test:integration": "pnpm build:shared && vitest run --config vitest.integration.config.ts",
    "db:up": "docker compose --env-file apps/server/.env -f infra/compose.dev.yml up -d --wait",
    "db:down": "docker compose --env-file apps/server/.env -f infra/compose.dev.yml down",
    "db:generate": "pnpm --filter @tongzhang/server db:generate",
    "db:migrate": "pnpm --filter @tongzhang/server db:migrate",
    "mobile:export": "pnpm build:shared && pnpm --filter @tongzhang/mobile export:check",
    "setup": "pnpm env:setup && pnpm db:up && pnpm db:migrate",
    "dev": "node scripts/dev.mjs",
    "dev:android": "node scripts/dev.mjs --android",
    "ios:build": "pnpm build:shared && pnpm --filter @tongzhang/mobile native:ios",
    "android:build": "pnpm build:shared && pnpm --filter @tongzhang/mobile native:android",
    "mobile:doctor": "pnpm dlx expo-doctor@1.21.5 apps/mobile",
    "mobile:deps": "pnpm --filter @tongzhang/mobile exec expo install --check",
    "container:test": "bash scripts/test-container.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.0.0",
    "concurrently": "10.0.6",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "type": "module"
}
