{
  "name": "tongzhang",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12.6.0 <13"
  },
  "scripts": {
    "setup": "pnpm setup:env && pnpm up:db && pnpm migrate:db",
    "setup:env": "node scripts/setup-env.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:ios": "node scripts/dev.mjs --ios",
    "dev:android": "node scripts/dev.mjs --android",
    "dev:shared": "pnpm --parallel --filter \"./packages/*\" dev",
    "dev:server": "pnpm build:shared && pnpm --filter @tongzhang/server build && concurrently -k -n shared,server \"pnpm dev:shared\" \"pnpm --filter @tongzhang/server dev\"",
    "dev:mobile": "pnpm build:shared && pnpm --filter @tongzhang/mobile dev",
    "build:shared": "pnpm -r --filter \"./packages/*\" build",
    "build:server": "pnpm build:shared && pnpm --filter @tongzhang/server build",
    "build:ios": "pnpm build:shared && pnpm --filter @tongzhang/mobile build:ios",
    "build:android": "pnpm build:shared && pnpm --filter @tongzhang/mobile build:android",
    "export:mobile": "pnpm build:shared && pnpm --filter @tongzhang/mobile export",
    "up:db": "docker compose --env-file apps/server/.env -f infra/compose.dev.yml up -d --wait",
    "down:db": "docker compose --env-file apps/server/.env -f infra/compose.dev.yml down",
    "generate:db": "pnpm --filter @tongzhang/server generate:db",
    "migrate:db": "pnpm --filter @tongzhang/server migrate:db",
    "check": "pnpm build:shared && pnpm typecheck && pnpm lint && pnpm check:format",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "check:format": "prettier --check .",
    "check:mobile-deps": "pnpm --filter @tongzhang/mobile exec expo install --check",
    "doctor:mobile": "pnpm dlx expo-doctor@1.21.5 apps/mobile",
    "format": "prettier --write .",
    "test": "pnpm build:shared && vitest run",
    "test:mobile": "pnpm build:shared && pnpm --filter @tongzhang/mobile test",
    "test:integration": "pnpm build:shared && vitest run --config vitest.integration.config.ts",
    "test:container": "bash scripts/test-container.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.0.0",
    "concurrently": "10.0.6",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "type": "module"
}
