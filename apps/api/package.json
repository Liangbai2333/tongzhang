{
  "name": "@tongzhang/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "concurrently -k -n tsc,server \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --watch dist/server.js\"",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tools.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts"
  },
  "dependencies": {
    "@tongzhang/contracts": "workspace:*",
    "@tongzhang/domain": "workspace:*",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "openapi-types": "12.1.3",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
