NODE_ENV=development
HOST=0.0.0.0
PORT=3300
# 本机 API 和开发 Compose 共用；端口是宿主机端口。
PGHOST=127.0.0.1
PGPORT=35432
PGUSER=tongzhang
PGPASSWORD=tongzhang_local_only
PGDATABASE=tongzhang
LOG_LEVEL=info
# 本机直接访问，不信任客户端转发头。
TRUST_PROXY=
# setup:env 会生成随机签名密钥；手动配置时使用 32 随机字节的 64 位小写 hex。
AUTH_JWT_SECRET=
# AI 辅助记账草稿解析（可选；仅存服务端环境，严禁放入移动端配置）。三项齐备时启用 OpenAI 兼容接口。
AI_DRAFT_API_BASE_URL=
AI_DRAFT_API_KEY=
AI_DRAFT_MODEL=
AI_DRAFT_TIMEOUT_MS=15000
