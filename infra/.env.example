# 仅供生产 Compose 使用；不会复制进镜像。
# 替换为发布工作流输出的镜像 digest；本地验证可使用本机镜像标签。
SERVER_IMAGE=ghcr.io/liangbai2333/tongzhang-server:sha-REPLACE_WITH_COMMIT
API_DOMAIN=api.example.com
POSTGRES_USER=tongzhang
# 单引号避免 Compose 展开密码中的 $；无需 URL 编码。
POSTGRES_PASSWORD='replace-with-a-strong-password'
POSTGRES_DB=tongzhang
LOG_LEVEL=info
# 若与宿主机已有网络冲突，改为未占用的私有网段。
PROXY_SUBNET=172.30.0.0/28
# 独立生成 32 随机字节的 64 位小写 hex，禁止提交真实值。
AUTH_JWT_SECRET=
